# zen-agent-bot — copy to .env and edit for your machine
#   cp .env.example .env && chmod 600 .env

# --- Secrets (never commit .env) ---
# Same keys can be set in admin UI → Settings → Secrets (SQLite; admin wins over env).

# One Discord app is enough: set the same token_env on every agent (usually MANAGER).
DISCORD_TOKEN_MANAGER=
# DISCORD_TOKEN_MUSIC=   # only if you still run a separate music bot
# DISCORD_TOKEN_GENERAL=
TELEGRAM_TOKEN_MANAGER=
TELEGRAM_TOKEN_MUSIC=
TELEGRAM_TOKEN_GENERAL=
DISCORD_GUILD_ID=
# ADMIN_PASSWORD=

# --- API keys (or set in admin UI → Secrets) ---
# OPENROUTER_API_KEY=
# CURSOR_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Set agent default_backend to openrouter in admin (restart after). Chat-only — no shell.

# --- Claude Code CLI (optional; Claude Pro/Max subscription) ---
# CLAUDE_BIN=claude
# CLAUDE_FORCE=true
# CLAUDE_MODEL=sonnet
# Install + `claude` login on host; set agent default_backend to claude-cli; restart.

# --- Cursor agent CLI ---

AGENT_BIN=agent
AGENT_FORCE=true
# AGENT_MODEL=composer-2.5
AGENT_WORKSPACE=/home/you

# --- Runtime (host systemd) ---

ZEN_AGENT_DATA_DIR=/home/you/apps/zen-agent-bot/data
LOG_LEVEL=INFO
# Must be 0.0.0.0 (not 127.0.0.1) so Traefik in Docker can reach host via host.docker.internal
ADMIN_LISTEN=0.0.0.0:8787
# STREAMING=true
# MAX_CONCURRENT_JOBS=2

# --- Legacy Docker mounts (only if still using compose) ---

HOST_DATA_DIR=./data
HOST_AGENTS_DIR=./agents
HOST_HOME=/home/you
CONTAINER_HOME=/home/agent
CURSOR_AGENT_DIR=/home/you/.local/share/cursor-agent
CURSOR_BIN=/home/you/.local/bin/agent
CURSOR_CONFIG_DIR=/home/you/.cursor
CURSOR_APP_CONFIG_DIR=/home/you/.config/cursor

# --- Legacy Traefik labels (Docker). Host install uses file provider instead. ---

CONTAINER_NAME=zen-agent-bot
IMAGE_NAME=zen-agent-bot:local
MEMORY_LIMIT=2048M
TZ=UTC
TRAEFIK_HOST=agents.example.com
TRAEFIK_ROUTER=zen-agent-admin
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf
TRAEFIK_NETWORK=proxy

# Optional one-time seed: copy data/config.example.yaml → data/config.yaml
# First start migrates YAML → SQLite if gateway.db has no agents.
