[Unit]
Description=zen-agent-bot gateway (Discord/Telegram → Cursor Agent)
Documentation=https://github.com/maximillian1508/zenbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maxi
Group=maxi
WorkingDirectory=/home/maxi/apps/zen-agent-bot
Environment=HOME=/home/maxi
Environment=PATH=/home/maxi/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/maxi/apps/zen-agent-bot/.env
# Prefer absolute data paths on host
Environment=ZEN_AGENT_DATA_DIR=/home/maxi/apps/zen-agent-bot/data
Environment=AGENT_WORKSPACE=/home/maxi
# Wait for in-flight agent jobs on stop/restart (must be < TimeoutStopSec).
Environment=SHUTDOWN_GRACE_SEC=600
ExecStart=/home/maxi/.local/bin/uv run --directory /home/maxi/apps/zen-agent-bot zen-agent-bot
Restart=on-failure
RestartSec=5
# Must be > SHUTDOWN_GRACE_SEC so gateway can wait for in-flight jobs.
TimeoutStopSec=620
KillMode=mixed
# Cursor agent + node tooling routinely exceeds 2G; a hard 2G cap OOM-kills
# the whole gateway mid-job (Discord stuck on "Agent running…"). Host has 14G.
MemoryHigh=3G
MemoryMax=6G
OOMPolicy=continue

# Agent needs to reach Discord, OpenRouter, Cursor, local APIs
# No NewNetwork — keep host networking for simplicity

[Install]
WantedBy=multi-user.target
