[Unit]
Description=Restart zen-agent-bot host service
After=network-online.target zen-agent-bot.service

[Service]
Type=oneshot
Environment=HOME=/home/maxi
Environment=ZENBOT_DATA_DIR=/home/maxi/apps/zen-agent-bot/data
Environment=ZENBOT_REBUILD_DELAY_SEC=15
Environment=ZENBOT_SYSTEMD_UNIT=zen-agent-bot.service
ExecStart=/home/maxi/apps/zen-agent-bot/scripts/deploy.sh
Nice=10
