[Unit]
Description=Rebuild zen-agent-bot Docker stack
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=maxi
Group=maxi
Environment=HOME=/home/maxi
Environment=ZENBOT_COMPOSE_DIR=/srv/apps/zen-agent-bot
Environment=ZENBOT_DATA_DIR=/home/maxi/apps/zen-agent-bot/data
Environment=ZENBOT_REBUILD_DELAY_SEC=15
# docker group membership (or rootless) must allow User=maxi to talk to the daemon
SupplementaryGroups=docker
ExecStart=/home/maxi/apps/zen-agent-bot/scripts/deploy.sh
Nice=10
